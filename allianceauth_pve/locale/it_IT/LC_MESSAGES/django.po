#: allianceauth_pve/admin.py:32 allianceauth_pve/api/schema.py:252
msgid "Locking the roles setup requires exactly 1 roles setup."
msgstr "Il blocco del setup dei ruoli richiede esattamente 1 setup dei ruoli."

#: allianceauth_pve/api/entries.py:180 allianceauth_pve/api/entries.py:232
#: allianceauth_pve/api/entries.py:264
msgid "The rotation is closed"
msgstr "La rotazione è chiusa"

#: allianceauth_pve/api/entries.py:229 allianceauth_pve/api/entries.py:261
msgid "You cannot edit this entry"
msgstr "Non puoi modificare quest'entrata"

#: allianceauth_pve/api/entries.py:238
msgid "One or more characters in this entry do not have a main character set"
msgstr ""
"Uno o più personaggi in questa entrata non hanno un personaggio principale "
"impostato"

#: allianceauth_pve/api/projects.py:120
msgid "You cannot complete a project with open contributions"
msgstr "Non puoi completare un progetto con delle contribuzioni ancora aperte"

#: allianceauth_pve/api/projects.py:129
msgid ""
"You cannot reopen this project, another one with the same name is active."
msgstr ""
"Non puoi riaprire questo progetto, ce n'è già un altro aperto con lo stesso "
"nome"

#: allianceauth_pve/api/schema.py:152
msgid "First site must be at least 1."
msgstr "Il primo sito deve essere almeno 1."

#: allianceauth_pve/api/schema.py:155
msgid "Last site must not be before the first site."
msgstr "L'ultimo sito non può precedere il primo."

#: allianceauth_pve/api/schema.py:220 allianceauth_pve/api/schema.py:291
msgid "Name must be between 1 and 128 characters long."
msgstr "Il nome deve contenere da 1 a 128 caratteri."

#: allianceauth_pve/api/schema.py:223 allianceauth_pve/api/schema.py:227
msgid "Tax rate must be between 0 and 100."
msgstr "La percentuale di tasse deve essere compresa tra 0 e 100."

#: allianceauth_pve/api/schema.py:232
msgid "The number of maximum daily setups must be non-negative."
msgstr "Il numero massimo di setup giornalieri non può essere negativo."

#: allianceauth_pve/api/schema.py:238
msgid ""
"The minimum number of people required to count a setup valid must be non-"
"negative."
msgstr ""
"Il numero minimo di persone necessario per considerare valido un setup non "
"può essere negativo."

#: allianceauth_pve/api/schema.py:244
msgid "One or more entry buttons are invalid."
msgstr "Uno o più pulsanti delle entrate non sono validi."

#: allianceauth_pve/api/schema.py:248
msgid "One or more roles setups are invalid."
msgstr "Uno o più setup dei ruoli non sono validi."

#: allianceauth_pve/api/schema.py:294
msgid "An active project with this name already exists."
msgstr "Esiste già un progetto attivo con questo nome."

#: allianceauth_pve/api/schema.py:297
msgid "Goal must be at least 1 ISK."
msgstr "L'obiettivo deve essere di almeno 1 ISK."

#: allianceauth_pve/api/schema.py:315
msgid "Sale value must be a non-negative integer."
msgstr "Il valore di vendita deve essere un numero intero non negativo."

#: allianceauth_pve/api/schema.py:318
msgid "Item has not been added in this rotation."
msgstr "L'oggetto non è stato aggiunto in questa rotazione."

#: allianceauth_pve/api/schema.py:340
msgid "Sales value must be a non-negative integer."
msgstr "Il valore delle vendite deve essere un numero intero non negativo."

#: allianceauth_pve/api/schema.py:382
msgid "Name must be between 1 and 64 characters long."
msgstr "Il nome deve contenere da 1 a 64 caratteri."

#: allianceauth_pve/api/schema.py:384
msgid "Role names must be unique within the entry."
msgstr "I nomi dei ruoli devono essere univoci all'interno dell'entrata."

#: allianceauth_pve/api/schema.py:389
msgid "Value must be non-negative."
msgstr "Il valore non può essere negativo."

#: allianceauth_pve/api/schema.py:469
msgid "Site ranges of a share must not overlap."
msgstr "Gli intervalli di siti di una quota non possono sovrapporsi."

#: allianceauth_pve/api/schema.py:479
msgid "Character does not exist."
msgstr "Il personaggio non esiste."

#: allianceauth_pve/api/schema.py:482
msgid "Character can only have one share in the entry."
msgstr "Un personaggio può avere una sola quota nell'entrata."

#: allianceauth_pve/api/schema.py:490
msgid "Character is not owned by any user."
msgstr "Il personaggio non appartiene a nessun utente."

#: allianceauth_pve/api/schema.py:495
msgid "A user can only have one share in the entry."
msgstr "Un utente può avere una sola quota nell'entrata."

#: allianceauth_pve/api/schema.py:502
msgid "Role name must match one of the roles defined in the entry."
msgstr ""
"Il nome del ruolo deve corrispondere a uno dei ruoli definiti nell'entrata."

#: allianceauth_pve/api/schema.py:525
msgid "Item does not exist or is not published."
msgstr "L'oggetto non esiste o non è pubblicato."

#: allianceauth_pve/api/schema.py:531
msgid "Item is ignored and cannot be added."
msgstr "L'oggetto è ignorato e non può essere aggiunto."

#: allianceauth_pve/api/schema.py:534
msgid "Quantity must be at least 1."
msgstr "La quantità deve essere almeno 1."

#: allianceauth_pve/api/schema.py:567
msgid "At least one role is required."
msgstr "È richiesto almeno un ruolo."

#: allianceauth_pve/api/schema.py:583
#, python-format
msgid "Roles must match the %(setup)s roles setup of this rotation."
msgstr ""
"I ruoli devono corrispondere al setup dei ruoli %(setup)s di questa "
"rotazione."

#: allianceauth_pve/api/schema.py:588
msgid "At least one share is required."
msgstr "È richiesta almeno una quota."

#: allianceauth_pve/api/schema.py:607
msgid "Form not valid, you need at least 1 person to receive loot"
msgstr "Form non valido, deve esserci almeno 1 persona a ricevere il loot"

#: allianceauth_pve/api/schema.py:617
#, python-format
msgid "No share covers site(s) %(sites)s."
msgstr "Nessuna quota copre i siti %(sites)s."

#: allianceauth_pve/api/schema.py:630
msgid "Estimated total must be non-negative."
msgstr "Il totale stimato non può essere negativo."

#: allianceauth_pve/api/schema.py:634
msgid ""
"Estimated total must be at least 1 ISK or you must add at least one item."
msgstr ""
"Il totale stimato deve essere di almeno 1 ISK, altrimenti devi aggiungere "
"almeno un oggetto."

#: allianceauth_pve/api/schema.py:645
msgid "Funding project does not exist or is not active."
msgstr "Il progetto di finanziamento non esiste o non è attivo."

#: allianceauth_pve/api/schema.py:649
msgid "Funding percentage is required when a funding project is specified."
msgstr ""
"La percentuale di finanziamento è obbligatoria quando è indicato un progetto"
" di finanziamento."

#: allianceauth_pve/api/schema.py:655
msgid "Funding percentage must be between 1 and 100."
msgstr "La percentuale di finanziamento deve essere compresa tra 1 e 100."

#: allianceauth_pve/auth_hooks.py:13
#: allianceauth_pve/templates/allianceauth_pve/base.html:5
#: allianceauth_pve/templates/allianceauth_pve/react_base.html:4
msgid "PvE Tool"
msgstr "Strumenti PvE"

#: allianceauth_pve/models.py:343 allianceauth_pve/models.py:747
msgid "relative role value"
msgstr "valore relativo del ruolo"

#: allianceauth_pve/models.py:345 allianceauth_pve/models.py:749
msgid ""
"Relative role value. Share values are computed using this field. If there "
"are 2 roles with 10 and 15, they'll receive 10/25 and 15/25 of the share "
"value."
msgstr ""
"Valore relativo del ruolo. I valori delle quote sono calcolati usando questo"
" campo. Se ci sono due ruoli con 10 e 15, riceveranno 10/25 e 15/25 "
"rispettivamente del valore della quota."

#: allianceauth_pve/models.py:367 allianceauth_pve/models.py:422
msgid ""
"The maximum number of helped setup per day. If more are submitted, only this"
" number is counted. 0 for deactivating helped setups."
msgstr ""
"Numero massimo di setup assistiti al giorno. Se ne vengono inviati di più, "
"viene conteggiato solo questo numero. 0 per disattivare i setup assistiti."

#: allianceauth_pve/models.py:373 allianceauth_pve/models.py:428
msgid ""
"The minimum number of users in an entry to consider the helped setup valid."
msgstr ""
"Numero minimo di utenti in un'entrata per considerare valido il setup "
"assistito."

#: allianceauth_pve/models.py:377 allianceauth_pve/models.py:432
msgid "Tax rate in percentage"
msgstr "Percentuale di tasse"

#: allianceauth_pve/models.py:379
msgid "Tax rate for loot items in percentage"
msgstr "Percentuale di tasse per gli oggetti del loot"

#: allianceauth_pve/models.py:384 allianceauth_pve/models.py:442
msgid "Ordering priority. The higher priorities are in the first positions."
msgstr ""
"Priorità di ordinamento. Le priorità più alte sono nelle prime posizioni."

#: allianceauth_pve/models.py:391 allianceauth_pve/models.py:449
msgid "Button to be shown in the Entry form."
msgstr "Pulsante da mostrare nel form dell'entrata."

#: allianceauth_pve/models.py:397 allianceauth_pve/models.py:455
msgid "Setup avaiable for loading in the Entry form."
msgstr "Setup disponibili da caricare nel form dell'entrata."

#: allianceauth_pve/models.py:403 allianceauth_pve/models.py:461
msgid ""
"Load the only roles setup automatically in every entry and prevent editing "
"roles. Requires exactly 1 roles setup."
msgstr ""
"Carica automaticamente l'unico setup dei ruoli in ogni entrata e impedisce "
"la modifica dei ruoli. Richiede esattamente 1 setup dei ruoli."

#: allianceauth_pve/models.py:411
#, python-format
msgid "%(name)s rotation preset"
msgstr "Preset della rotazione %(name)s"

#: allianceauth_pve/models.py:590
msgid "relative value"
msgstr "valore relativo"

#: allianceauth_pve/models.py:616
msgid "Flat"
msgstr "Fisso"

#: allianceauth_pve/models.py:617
msgid "Fabricator"
msgstr "Fabricator"
