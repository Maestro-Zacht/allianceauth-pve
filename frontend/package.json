{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && ./copy-assets.sh",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "buildApiTypes": "pnpm exec openapi-typescript ./openapi.json -o ./src/api/Schema.d.ts",
    "buildTranslations": "pnpm exec i18next-cli extract"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.5",
    "@types/js-cookie": "^3.0.6",
    "bootstrap": "^5.3.8",
    "datatables.net-bs5": "^3.1.4",
    "datatables.net-columncontrol-bs5": "^2.1.2",
    "datatables.net-react": "^1.0.2",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "i18next-http-backend": "^4.0.5",
    "js-cookie": "^3.0.8",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0",
    "react-timeago": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "i18next-cli": "^1.80.4",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
